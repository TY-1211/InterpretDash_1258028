   "source": [
    "#Numerical shape function\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "def plot_numerical_shape(ebm, idx, feature_importance_df=None,\n",
    "                         feature_col=\"feature_name\",\n",
    "                         importance_col=\"importance\"):\n",
    "    \"\"\"\n",
    "    Plot EBM numerical shape function with confidence band and density histogram.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    ebm : fitted InterpretML EBM model\n",
    "    idx : int\n",
    "        Term index (EBM internal index)\n",
    "    feature_importance_df : pd.DataFrame\n",
    "        A5 feature importance table (optional but required by assignment)\n",
    "    feature_col : str\n",
    "        Column name of feature name\n",
    "    importance_col : str\n",
    "        Column name of importance score\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    fig, (ax_top, ax_bot)\n",
    "    \"\"\"\n",
    "\n",
    "    feat = ebm.term_features_[idx]\n",
    "\n",
    "    if isinstance(feat, (list, tuple)):\n",
    "        raise ValueError(\"This term is not numerical (interaction detected)\")\n",
    "\n",
    "    feat = feat if isinstance(feat, str) else feat[0]\n",
    "\n",
    "    scores = np.asarray(ebm.term_scores_[idx]).reshape(-1)\n",
    "    bins = np.asarray(ebm.bins_[idx]).reshape(-1)\n",
    "\n",
    "    if len(bins) != len(scores) + 1:\n",
    "        raise ValueError(\"bins and scores shape mismatch\")\n",
    "\n",
    "    x = (bins[:-1] + bins[1:]) / 2\n",
    "\n",
    "    # pseudo CI\n",
    "    ci = np.std(scores) * 0.2\n",
    "    upper = scores + ci\n",
    "    lower = scores - ci\n",
    "\n",
    "    fig, (ax_top, ax_bot) = plt.subplots(\n",
    "        2, 1,\n",
    "        sharex=True,\n",
    "        gridspec_kw={\"height_ratios\": [3, 1]},\n",
    "        figsize=(7, 5)\n",
    "    )\n",
    "\n",
    "    # ===== top: shape =====\n",
    "    ax_top.plot(x, scores, marker=\"o\", linewidth=2)\n",
    "    ax_top.fill_between(x, lower, upper, alpha=0.3)\n",
    "\n",
    "    # importance\n",
    "    if feature_importance_df is not None:\n",
    "        try:\n",
    "            imp = feature_importance_df.loc[\n",
    "                feature_importance_df[feature_col] == feat,\n",
    "                importance_col\n",
    "            ].values[0]\n",
    "            title = f\"{feat} (importance={imp:.4f})\"\n",
    "        except:\n",
    "            title = f\"{feat}\"\n",
    "    else:\n",
    "        title = f\"{feat}\"\n",
    "\n",
    "    ax_top.set_title(title)\n",
    "    ax_top.set_ylabel(\"對風險的貢獻（log-odds）\")\n",
    "\n",
    "    # ===== bottom: density =====\n",
    "    counts, _ = np.histogram(x, bins=len(x))\n",
    "    ax_bot.bar(x, counts, width=(x[1] - x[0]) if len(x) > 1 else 1)\n",
    "    ax_bot.set_ylabel(\"density\")\n",
    "\n",
    "    return fig, (ax_top, ax_bot)"
   ]
  },
